# cp .env.example .env 후 "필수" 항목만 확인하고 ./bootstrap.sh 를 실행한다.
# 비어 있는 비밀값·비밀번호는 bootstrap.sh 가 처음 실행할 때 무작위로 만들어 이 파일에 적는다.
# (이미 값이 있으면 그대로 쓴다. 한 번 띄운 뒤에는 비밀값을 바꾸지 않는다 — DB·세션이 그 값에 묶인다)

# ===== 필수 =====
# 브라우저와 Open WebUI 컨테이너가 모두 new-api 에 닿을 수 있는 호스트 이름 (README 2절)
#  - LAN + 공개 DNS: 192-168-0-10.nip.io   (호스트 IP 를 - 로 이어 씀)
#  - 사내 DNS 이름이 있으면 그 이름
#  - 오프라인이면 newapi.local 같은 이름 + /etc/hosts + compose 의 extra_hosts 주석 해제
PUBLIC_HOST=192-168-0-10.nip.io

# 미리 받아 두거나 빌드해 둔 이미지 (README 1절). bootstrap.sh 는 빌드하지 않는다.
NEW_API_IMAGE=new-api-owui:latest
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
MCP_IMAGE=openwebui-rag-mcp-newapi:latest
POSTGRES_IMAGE=postgres:15-alpine
REDIS_IMAGE=redis:7-alpine

# ===== 포트 =====
NEW_API_PORT=3000
OPEN_WEBUI_PORT=8080
# MCP 서버. 127.0.0.1 이면 이 호스트에서만, 0.0.0.0 이면 사내망 전체에서 접속 (내부망 전용으로만 열 것)
MCP_BIND=127.0.0.1
MCP_PORT=8000
TZ=Asia/Seoul

# ===== new-api 관리자 =====
NEW_API_ROOT_USER=root
# 8~20자. 비워 두면 bootstrap.sh 가 만들어 적고 화면에 한 번 출력한다
NEW_API_ROOT_PASSWORD=
# 루트로 Open WebUI 에도 로그인하려면 이메일이 필요하다 (OIDC 가 email 클레임을 요구). 비워 두면 넣지 않는다
NEW_API_ROOT_EMAIL=admin@example.com
# Open WebUI 가 모델·임베딩 호출에 쓰는 서비스 계정 (bootstrap.sh 가 만든다)
NEW_API_SERVICE_USER=owui-svc
NEW_API_SERVICE_PASSWORD=

# ===== 서로 주고받는 값 (비워 두면 bootstrap.sh 가 생성) =====
PG_USER=newapi
PG_DB=newapi
PG_PASSWORD=
REDIS_PASSWORD=
NEW_API_SESSION_SECRET=
NEW_API_CRYPTO_SECRET=
# new-api OIDC 제공자 ↔ Open WebUI 로그인 클라이언트
OIDC_CLIENT_ID=openwebui
OIDC_CLIENT_SECRET=
# new-api 가 MCP 용 토큰을 발급할 client_id (Open WebUI 의 OAUTH_TOKEN_EXCHANGE_TRUSTED_CLIENT_IDS 와 같은 값이 들어간다)
OIDC_MCP_CLIENT_ID=openwebui-mcp
# Open WebUI → new-api relay 서명 JWT 비밀
OWUI_JWT_SECRET=
# Open WebUI 세션 비밀
OWUI_SECRET_KEY=
# bootstrap.sh 가 채운다 (new-api 서비스 토큰). 직접 넣지 않는다
OWUI_SERVICE_KEY=

# ===== Open WebUI 동작 =====
# 지식 베이스 색인에 쓸 임베딩 모델. new-api 에 이 이름을 서비스하는 채널이 있어야 한다 (README 5절)
OWUI_EMBEDDING_MODEL=text-embedding-3-small
# 모델 접근 제어를 Open WebUI 가 아니라 new-api 쪽에서만 한다 (true: 모든 사용자가 new-api 가 허용한 모델을 봄)
OWUI_BYPASS_MODEL_ACCESS_CONTROL=true
# 일반 사용자에게 지식 베이스 만들기 권한 (Open WebUI 기본값은 관리자만)
OWUI_USER_KNOWLEDGE_ACCESS=true
OWUI_GROUP_MANAGEMENT=false

# ===== MCP =====
MCP_MAX_COLLECTIONS=20
# 선택: Open WebUI API 키 방식 MCP(--profile owui-key). true 면 bootstrap.sh 가 함께 띄운다
OWUI_ENABLE_API_KEYS=false
MCP_OWUI_KEY_IMAGE=openwebui-rag-mcp:latest
MCP_OWUI_KEY_PORT=8001

# 스테이징 전용. 운영에서는 false
NEW_API_DEBUG=false

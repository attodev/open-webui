# cp .env.example .env 후 값을 채운다. 비밀값은 `openssl rand -base64 36` 등으로 만든다.

# 브라우저와 Open WebUI 컨테이너가 모두 new-api 에 닿을 수 있는 호스트 이름 (IP 가 아닌 이름 권장).
#  - LAN 에서 바로 쓰려면 nip.io: 예) 192-168-0-10.nip.io  (→ 192.168.0.10 으로 풀림, 추가 설정 불필요)
#  - 사내 DNS 이름이 있으면 그 이름
#  - 오프라인이면 newapi.local 같은 이름 + 브라우저 머신 /etc/hosts + compose 의 extra_hosts 주석 해제
PUBLIC_HOST=192-168-0-10.nip.io
NEW_API_PORT=3000
OPEN_WEBUI_PORT=8080
TZ=Asia/Seoul

# new-api 이미지 (README 1절에서 만든 태그)
NEW_API_IMAGE=new-api-owui:latest
# Open WebUI 이미지. 문서 검증 기준 v0.11.4. 가능하면 태그를 고정한다.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# ---- DB / 캐시 ----
PG_USER=newapi
PG_PASSWORD=change-me-pg
PG_DB=newapi
REDIS_PASSWORD=change-me-redis

# ---- new-api 프로세스 비밀 (32바이트 이상, 노드 간 동일) ----
NEW_API_SESSION_SECRET=change-me-32-bytes-or-more-session-secret
NEW_API_CRYPTO_SECRET=change-me-32-bytes-or-more-crypto-secret
NEW_API_DEBUG=false

# ---- bootstrap.sh 가 new-api 에 만드는 계정 ----
# new-api 사용자 비밀번호는 8~20자, 사용자 이름은 최대 20자다 (model.User 검증). openssl rand -base64 12 정도가 적당하다.
NEW_API_ROOT_USER=root
NEW_API_ROOT_PASSWORD=change-me-root-pass
# 루트에 이메일을 주면 루트로도 Open WebUI 에 로그인할 수 있다(이메일 서버 없이 psql 로 넣는다).
# 단, 관리자·루트는 relay 자동 연결 대상이 아니라 로그인 뒤 사용자 편집 → "Open WebUI 연결" 에서 수동 연결해야 모델이 보인다.
NEW_API_ROOT_EMAIL=
NEW_API_SERVICE_USER=owui-svc
NEW_API_SERVICE_PASSWORD=change-me-svc-pass
# 테스트 사용자 (쉼표 구분 "아이디:비밀번호:이메일"). 비워 두면 만들지 않는다.
NEW_API_TEST_USERS=alice:change-me-alice-pass:alice@example.com,bob:change-me-bob-pass:bob@example.com

# ---- Open WebUI ↔ new-api 공유 비밀 ----
OIDC_CLIENT_ID=openwebui
OIDC_CLIENT_SECRET=change-me-client-secret-16-plus
OWUI_JWT_SECRET=change-me-jwt-secret-32-bytes-or-more-random
OWUI_SECRET_KEY=change-me-openwebui-session-key
# bootstrap.sh 가 채운다 (서비스 토큰 키). 직접 넣지 않는다.
OWUI_SERVICE_KEY=

# ---- 선택 ----
OWUI_GROUP_MANAGEMENT=false
OWUI_EMBEDDING_MODEL=text-embedding-3-small
# 1 이면 bootstrap.sh 가 mock-upstream 채널(모델 mock-gpt)을 만든다. compose 는 --profile mock 으로 띄운다.
MOCK_UPSTREAM=0

# ---- RAG MCP 서버 ----
# 바인드 주소. 127.0.0.1 이면 이 호스트에서만, 0.0.0.0 이면 사내망 전체에서 접속 가능 (내부망 전용으로만 열 것)
MCP_BIND=127.0.0.1
MCP_PORT=8000
MCP_MAX_COLLECTIONS=20
# new-api 가 MCP 용 토큰을 발급할 client_id. bootstrap.sh 와 Open WebUI 의 TRUSTED_CLIENT_IDS 가 함께 쓴다.
OIDC_MCP_CLIENT_ID=openwebui-mcp
# 선택: Open WebUI API 키 방식 MCP(--profile owui-key)를 쓸 때만 true
OWUI_ENABLE_API_KEYS=false
MCP_OWUI_KEY_PORT=8001

# ---- 자동화 (setup.sh / bootstrap-rag.sh) ----
# 임베딩 채널. MOCK_UPSTREAM=1 이면 무시하고 mock-embedding 채널을 만든다.
# 실제 공급자를 쓰려면 키를 넣는다 (채널 유형 1 = OpenAI 호환). 비워 두면 채널은 직접 만든다.
EMBEDDING_CHANNEL_TYPE=1
EMBEDDING_CHANNEL_BASE_URL=
EMBEDDING_CHANNEL_KEY=
# 1 이면 NEW_API_TEST_USERS 를 OIDC 로 Open WebUI 에 한 번 로그인시켜 계정을 만든다 (MCP 사용 조건)
OWUI_AUTO_LOGIN_TEST_USERS=1
# 1 이면 첫 테스트 사용자 이름으로 'MCP 샘플' 지식 베이스를 만들고 MCP 검색까지 확인한다
SEED_SAMPLE_KNOWLEDGE=1
# Open WebUI 모델 접근 제어를 끄고(모든 사용자가 모든 모델을 봄) new-api 쪽 제한만 쓴다
OWUI_BYPASS_MODEL_ACCESS_CONTROL=true
# 일반 사용자에게 지식 베이스 만들기 권한을 준다 (Open WebUI 기본값은 관리자만)
OWUI_USER_KNOWLEDGE_ACCESS=true
# 운영 compose(docker-compose.run.yml)가 쓸 MCP 이미지 (다른 머신으로 옮겼다면 그 태그)
MCP_IMAGE=openwebui-rag-mcp-newapi:local
